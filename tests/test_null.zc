//> link: -lpq

import "std/io.zc"
import "std/string.zc"
import "../pg/pg.zc"
import "./common.zc"

test "get returns None for null values" {
    let conninfo = get_test_conninfo();
    let conn_res = PgConnection::new(conninfo);
    assert(!conn_res.is_err(), "Connection failed");
    let conn = conn_res.unwrap();

    conn.exec("DROP TABLE IF EXISTS zenc_test_suite");
    conn.exec("CREATE TABLE zenc_test_suite (id SERIAL PRIMARY KEY, name TEXT)");
    conn.exec("INSERT INTO zenc_test_suite (name) VALUES (NULL)");

    let query_res = conn.query("SELECT name FROM zenc_test_suite");
    assert(!query_res.is_err(), "SELECT failed");
    let result = query_res.unwrap();

    assert(result.row_count() == 1, "Expected 1 row");

    let maybe_name = result.get(0, 0);
    assert(maybe_name.is_none(), "Expected name to be NULL");

    conn.exec("DROP TABLE IF EXISTS zenc_test_suite");
    "get returns None for null values passed";
}
