import "./sys.zc"

import "std/option.zc"
import "std/result.zc"
import "std/string.zc"
import "std/sync.zc"
import "std/mem.zc"

extern fn _z_pg_connect(conninfo: const char*) -> void*;
extern fn _z_pg_finish(conn: void*);
extern fn _z_pg_status(conn: void*) -> c_int;
extern fn _z_pg_error(conn: void*) -> char*;
extern fn _z_pg_exec(conn: void*, command: const char*) -> void*;
extern fn _z_pg_exec_params(conn: void*, command: const char*, nParams: c_int, paramValues: char**) -> void*;
extern fn _z_pg_clear(res: void*);
extern fn _z_pg_result_status(res: void*) -> c_int;
extern fn _z_pg_result_error(res: void*) -> char*;
extern fn _z_pg_ntuples(res: void*) -> c_int;
extern fn _z_pg_nfields(res: void*) -> c_int;
extern fn _z_pg_fname(res: void*, col: c_int) -> char*;
extern fn _z_pg_getvalue(res: void*, row: c_int, col: c_int) -> char*;
extern fn _z_pg_getisnull(res: void*, row: c_int, col: c_int) -> c_int;
extern fn _z_pg_connection_ok() -> c_int;
extern fn _z_pg_res_command_ok() -> c_int;
extern fn _z_pg_res_tuples_ok() -> c_int;

struct PgConnection {
    handle: void*;
}

struct PgResult {
    handle: void*;
}

impl PgConnection {
    fn new(conninfo: char*) -> Result<PgConnection> {
        let handle = _z_pg_connect(conninfo);
        if (handle == NULL) {
            return Result<PgConnection>::Err("Failed to allocate connection");
        }
        let status = _z_pg_status(handle);
        if (status != _z_pg_connection_ok()) {
            _z_pg_finish(handle);
            return Result<PgConnection>::Err("Connection failed");
        }
        return Result<PgConnection>::Ok(PgConnection { handle: handle });
    }

    fn query(self, sql: char*) -> Result<PgResult> {
        let res = _z_pg_exec(self.handle, sql);
        if (res == NULL) {
            return Result<PgResult>::Err("Query failed (out of memory)");
        }
        let status = _z_pg_result_status(res);
        if (status != _z_pg_res_command_ok() && status != _z_pg_res_tuples_ok()) {
            _z_pg_clear(res);
            return Result<PgResult>::Err("Query failed");
        }
        return Result<PgResult>::Ok(PgResult { handle: res });
    }

    fn exec(self, sql: char*) -> Result<bool> {
        let res = _z_pg_exec(self.handle, sql);
        if (res == NULL) {
            return Result<bool>::Err("Exec failed (out of memory)");
        }
        let status = _z_pg_result_status(res);
        _z_pg_clear(res);
        if (status != _z_pg_res_command_ok()) {
            return Result<bool>::Err("Exec failed");
        }
        return Result<bool>::Ok(true);
    }

    fn query_params(self, sql: char*, params: char**, nParams: c_int) -> Result<PgResult> {
        let res = _z_pg_exec_params(self.handle, sql, nParams, params);
        if (res == NULL) {
            return Result<PgResult>::Err("Query params failed (out of memory)");
        }
        let status = _z_pg_result_status(res);
        if (status != _z_pg_res_command_ok() && status != _z_pg_res_tuples_ok()) {
            _z_pg_clear(res);
            return Result<PgResult>::Err("Query params failed");
        }
        return Result<PgResult>::Ok(PgResult { handle: res });
    }

    fn exec_params(self, sql: char*, params: char**, nParams: c_int) -> Result<bool> {
        let res = _z_pg_exec_params(self.handle, sql, nParams, params);
        if (res == NULL) {
            return Result<bool>::Err("Exec params failed (out of memory)");
        }
        let status = _z_pg_result_status(res);
        _z_pg_clear(res);
        if (status != _z_pg_res_command_ok()) {
            return Result<bool>::Err("Exec params failed");
        }
        return Result<bool>::Ok(true);
    }

    fn last_error(self) -> String {
        return String::from(_z_pg_error(self.handle));
    }

    fn begin(self) -> Result<Transaction> {
        let res = self.exec("BEGIN");
        if (res.is_err()) {
            return Result<Transaction>::Err("BEGIN failed");
        }
        return Result<Transaction>::Ok(Transaction { handle: self.handle, committed: false });
    }
}

impl Drop for PgConnection {
    fn drop(self) {
        if (self.handle != NULL) {
            _z_pg_finish(self.handle);
            self.handle = NULL;
        }
    }
}

impl PgResult {
    fn row_count(self) -> c_int {
        return _z_pg_ntuples(self.handle);
    }

    fn column_count(self) -> c_int {
        return _z_pg_nfields(self.handle);
    }

    fn column_name(self, col: c_int) -> String {
        return String::from(_z_pg_fname(self.handle, col));
    }

    fn get(self, row: c_int, col: c_int) -> Option<String> {
        if (_z_pg_getisnull(self.handle, row, col)) {
            return Option<String>::None();
        }
        return Option<String>::Some(String::from(_z_pg_getvalue(self.handle, row, col)));
    }
}

impl Drop for PgResult {
    fn drop(self) {
        if (self.handle != NULL) {
            _z_pg_clear(self.handle);
            self.handle = NULL;
        }
    }
}

struct Transaction {
    handle: void*;
    committed: bool;
}

impl Transaction {
    fn commit(self) -> Result<bool> {
        self.committed = true;
        let res = self.exec("COMMIT");
        if (res.is_err()) {
            return Result<bool>::Err("COMMIT failed");
        }
        return Result<bool>::Ok(true);
    }

    fn rollback(self) -> Result<bool> {
        self.committed = true;
        let res = self.exec("ROLLBACK");
        if (res.is_err()) {
            return Result<bool>::Err("ROLLBACK failed");
        }
        return Result<bool>::Ok(true);
    }

    fn exec(self, sql: char*) -> Result<bool> {
        let res = _z_pg_exec(self.handle, sql);
        if (res == NULL) {
            return Result<bool>::Err("Exec failed (out of memory)");
        }
        let status = _z_pg_result_status(res);
        _z_pg_clear(res);
        if (status != _z_pg_res_command_ok()) {
            return Result<bool>::Err("Exec failed");
        }
        return Result<bool>::Ok(true);
    }

    fn query(self, sql: char*) -> Result<PgResult> {
        let res = _z_pg_exec(self.handle, sql);
        if (res == NULL) {
            return Result<PgResult>::Err("Query failed (out of memory)");
        }
        let status = _z_pg_result_status(res);
        if (status != _z_pg_res_command_ok() && status != _z_pg_res_tuples_ok()) {
            _z_pg_clear(res);
            return Result<PgResult>::Err("Query failed");
        }
        return Result<PgResult>::Ok(PgResult { handle: res });
    }

    fn query_params(self, sql: char*, params: char**, nParams: c_int) -> Result<PgResult> {
        let res = _z_pg_exec_params(self.handle, sql, nParams, params);
        if (res == NULL) {
            return Result<PgResult>::Err("Query params failed (out of memory)");
        }
        let status = _z_pg_result_status(res);
        if (status != _z_pg_res_command_ok() && status != _z_pg_res_tuples_ok()) {
            _z_pg_clear(res);
            return Result<PgResult>::Err("Query params failed");
        }
        return Result<PgResult>::Ok(PgResult { handle: res });
    }

    fn exec_params(self, sql: char*, params: char**, nParams: c_int) -> Result<bool> {
        let res = _z_pg_exec_params(self.handle, sql, nParams, params);
        if (res == NULL) {
            return Result<bool>::Err("Exec params failed (out of memory)");
        }
        let status = _z_pg_result_status(res);
        _z_pg_clear(res);
        if (status != _z_pg_res_command_ok()) {
            return Result<bool>::Err("Exec params failed");
        }
        return Result<bool>::Ok(true);
    }

    fn last_error(self) -> String {
        return String::from(_z_pg_error(self.handle));
    }
}

impl Drop for Transaction {
    fn drop(self) {
        if (!self.committed && self.handle != NULL) {
            let res = _z_pg_exec(self.handle, "ROLLBACK");
            if (res != NULL) {
                _z_pg_clear(res);
            }
            self.committed = true;
        }
    }
}

// --- Async wrappers ---
// Note: ZenC's async/await is currently implemented using OS threads.
// These wrappers spawn a background thread to run the blocking libpq call.
// The connection / transaction pointer must remain valid until the future is awaited.

async fn pg_connect_async(conninfo: char*) -> Result<PgConnection> {
    return PgConnection::new(conninfo);
}

async fn pg_query_async(conn: PgConnection*, sql: char*) -> Result<PgResult> {
    return conn.query(sql);
}

async fn pg_exec_async(conn: PgConnection*, sql: char*) -> Result<bool> {
    return conn.exec(sql);
}

async fn pg_query_params_async(conn: PgConnection*, sql: char*, params: char**, nParams: int) -> Result<PgResult> {
    return conn.query_params(sql, params, nParams);
}

async fn pg_exec_params_async(conn: PgConnection*, sql: char*, params: char**, nParams: int) -> Result<bool> {
    return conn.exec_params(sql, params, nParams);
}

async fn pg_begin_async(conn: PgConnection*) -> Result<Transaction> {
    return conn.begin();
}

async fn pg_tx_commit_async(tx: Transaction*) -> Result<bool> {
    return tx.commit();
}

async fn pg_tx_rollback_async(tx: Transaction*) -> Result<bool> {
    return tx.rollback();
}

async fn pg_tx_exec_async(tx: Transaction*, sql: char*) -> Result<bool> {
    return tx.exec(sql);
}

async fn pg_tx_query_async(tx: Transaction*, sql: char*) -> Result<PgResult> {
    return tx.query(sql);
}

async fn pg_tx_query_params_async(tx: Transaction*, sql: char*, params: char**, nParams: int) -> Result<PgResult> {
    return tx.query_params(sql, params, nParams);
}

async fn pg_tx_exec_params_async(tx: Transaction*, sql: char*, params: char**, nParams: int) -> Result<bool> {
    return tx.exec_params(sql, params, nParams);
}

// --- Connection Pool ---

struct PgPool {
    conninfo: char*;
    max_size: int;
    connections: PgConnection*;
    in_use: bool*;
    mut: Mutex;
    cond: CondVar;
}

struct PooledConnection {
    pool: PgPool*;
    index: int;
    conn: PgConnection*;
}

impl PgPool {
    fn new(conninfo: char*, max_size: int) -> Result<PgPool> {
        if (max_size <= 0) {
            return Result<PgPool>::Err("Pool size must be positive");
        }

        let connections = alloc_n<PgConnection>(max_size);
        let in_use = alloc_n<bool>(max_size);

        for (let i = 0; i < max_size; i = i + 1) {
            in_use[i] = false;
        }

        for (let i = 0; i < max_size; i = i + 1) {
            let conn_res = PgConnection::new(conninfo);
            if (conn_res.is_err()) {
                for (let j = 0; j < i; j = j + 1) {
                    if (connections[j].handle != NULL) {
                        _z_pg_finish(connections[j].handle);
                        connections[j].handle = NULL;
                    }
                }
                dealloc<PgConnection>(connections);
                dealloc<bool>(in_use);
                return Result<PgPool>::Err("Failed to initialize pool connection");
            }
            connections[i] = conn_res.unwrap();
        }

        return Result<PgPool>::Ok(PgPool {
            conninfo: conninfo,
            max_size: max_size,
            connections: connections,
            in_use: in_use,
            mut: Mutex::new(),
            cond: CondVar::new()
        });
    }

    fn get(self) -> Result<PooledConnection> {
        self.mut.lock();

        while (true) {
            for (let i = 0; i < self.max_size; i = i + 1) {
                if (!self.in_use[i]) {
                    self.in_use[i] = true;
                    self.mut.unlock();
                    let conn = &self.connections[i];
                    return Result<PooledConnection>::Ok(PooledConnection {
                        pool: self,
                        index: i,
                        conn: conn
                    });
                }
            }
            self.cond.wait(&self.mut);
        }

        return Result<PooledConnection>::Err("Pool get failed");
    }

    fn _release(self, index: int) {
        self.mut.lock();
        self.in_use[index] = false;
        self.cond.signal();
        self.mut.unlock();
    }
}

impl Drop for PgPool {
    fn drop(self) {
        for (let i = 0; i < self.max_size; i = i + 1) {
            if (self.connections[i].handle != NULL) {
                _z_pg_finish(self.connections[i].handle);
                self.connections[i].handle = NULL;
            }
        }
        dealloc<PgConnection>(self.connections);
        dealloc<bool>(self.in_use);
    }
}

impl PooledConnection {
    fn exec(self, sql: char*) -> Result<bool> {
        return self.conn.exec(sql);
    }

    fn query(self, sql: char*) -> Result<PgResult> {
        return self.conn.query(sql);
    }

    fn query_params(self, sql: char*, params: char**, nParams: int) -> Result<PgResult> {
        return self.conn.query_params(sql, params, nParams);
    }

    fn exec_params(self, sql: char*, params: char**, nParams: int) -> Result<bool> {
        return self.conn.exec_params(sql, params, nParams);
    }

    fn last_error(self) -> String {
        return self.conn.last_error();
    }

    fn begin(self) -> Result<Transaction> {
        return self.conn.begin();
    }

    fn release(self) {
        if (self.pool != NULL) {
            self.pool._release(self.index);
            self.pool = NULL;
            self.conn = NULL;
            self.index = -1;
        }
    }
}

impl Drop for PooledConnection {
    fn drop(self) {
        self.release();
    }
}

async fn pg_pool_get_async(pool: PgPool*) -> Result<PooledConnection> {
    return pool.get();
}
